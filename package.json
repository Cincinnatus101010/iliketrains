{
  "name": "iliketrains",
  "private": false,
  "version": "0.2.0",
  "description": "NJ Transit live rail map — Next.js, steddy, Troisi UI, sickmaps",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "dev:clean": "rm -rf .next && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,css,md}": "biome check --write --no-errors-on-unmatched"
  },
  "dependencies": {
    "@iantroisi/sickmaps": "^0.1.1",
    "@iantroisi/ui": "^0.1.3",
    "gtfs-realtime-bindings": "^2.2.0",
    "maplibre-gl": "^5.6.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "steddy": "file:../steddy"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "typescript": "^5.7.2"
  }
}
